import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;
import java.time.Duration;
import java.util.List;
import java.util.Set;

public class AmazonAutomationAssignment {

    public static void main(String[] args) {
        // Initialize WebDriver (Selenium 4 automatically manages the driver binaries)
        WebDriver driver = new ChromeDriver();
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(15));
        boolean isTestPassed = false;

        try {
            // 1. Launch Chrome, navigate to the website, and maximize window
            driver.get("https://www.amazon.in/");
            driver.manage().window().maximize();

            // 2. Click "Sign In" and log in using a pre-registered test account
            WebElement signInLink = wait.until(ExpectedConditions.elementToBeClickable(By.id("nav-link-accountList")));
            signInLink.click();

            // Enter Email or Mobile Phone Number
            WebElement emailField = wait.until(ExpectedConditions.visibilityOfElementLocated(By.id("ap_email")));
            emailField.sendKeys("YOUR_TEST_EMAIL_OR_PHONE"); // Replace with actual test credential
            driver.findElement(By.id("continue")).click();

            // Enter Password
            WebElement passwordField = wait.until(ExpectedConditions.visibilityOfElementLocated(By.id("ap_password")));
            passwordField.sendKeys("YOUR_TEST_PASSWORD"); // Replace with actual test password
            driver.findElement(By.id("signInSubmit")).click();

            // 3. Verify that the account name is displayed in the navigation bar after successful login
            WebElement accountNameElement = wait.until(ExpectedConditions.visibilityOfElementLocated(By.id("nav-link-accountList-nav-line-1")));
            String accountText = accountNameElement.getText();
            
            if (accountText.toLowerCase().contains("sign in")) {
                throw new Exception("Verification Failed: User is not logged in properly.");
            }
            System.out.println("Login confirmation: " + accountText);

            // 4. Search for "wireless mouse" using the search box and verify the results page shows relevant products
            WebElement searchBox = wait.until(ExpectedConditions.elementToBeClickable(By.id("twotabsearchtextbox")));
            searchBox.sendKeys("wireless mouse");
            driver.findElement(By.id("nav-search-submit-button")).click();

            // Locate product titles on the results page
            wait.until(ExpectedConditions.visibilityOfElementLocated(By.cssSelector("span.s-line-clamp-2")));
            List<WebElement> searchResults = driver.findElements(By.cssSelector("h2 a span"));
            
            if (searchResults.isEmpty()) {
                throw new Exception("Verification Failed: No products displayed in search results.");
            }
            
            // Verify relevance by checking if the first product text contains the keyword
            String firstProductTitle = searchResults.get(0).getText().toLowerCase();
            if (!firstProductTitle.contains("mouse")) {
                throw new Exception("Verification Failed: Search results do not appear to be relevant.");
            }

            // 5. Open the first product from the results and click "Add to Cart"
            String parentWindow = driver.getWindowHandle();
            searchResults.get(0).click();

            // Handle the new browser tab that opens for the product detail view
            Set<String> allWindows = driver.getWindowHandles();
            for (String window : allWindows) {
                if (!window.equals(parentWindow)) {
                    driver.switchTo().window(window);
                    break;
                }
            }

            // Add the selected item to the cart
            WebElement addToCartButton = wait.until(ExpectedConditions.elementToBeClickable(By.id("add-to-cart-button")));
            addToCartButton.click();

            // Verify item was successfully added by checking the confirmation header/panel
            wait.until(ExpectedConditions.visibilityOfElementLocated(By.id("attach-display-text-append-around-or-error-message")));
            
            // If execution reaches this point without throwing any exceptions, the script passes
            isTestPassed = true;

        } catch (Exception e) {
            System.out.println("Exception encountered during execution: " + e.getMessage());
            isTestPassed = false;
        } finally {
            // 6. Display PASS/FAIL
            if (isTestPassed) {
                System.out.println("====================");
                System.out.println("FINAL RESULT: PASS");
                System.out.println("====================");
            } else {
                System.out.println("====================");
                System.out.println("FINAL RESULT: FAIL");
                System.out.println("====================");
            }

            // 7. Close the browser
            driver.quit();
        }
    }
}
